# ─── WasteWise environment ─────────────────────────────────────────────
# Copy to .env and adjust. Never commit real secrets.

APP_ENV=development                # development | test | production
LOG_LEVEL=INFO

# Prototype: SQLite file (created + seeded automatically).
# Production target (docker-compose): postgresql+psycopg://wastewise:wastewise@db:5432/wastewise
DATABASE_URL=sqlite:///./wastewise.db

# Comma-separated allowed origins for the frontend dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo/simulation endpoints (POST /demo/*). MUST be false in production.
DEMO_MODE=true

# Demo fuel assumptions (clearly labelled wherever shown)
FUEL_PRICE_PER_LITRE=94.5
FUEL_CONSUMPTION_L_PER_100KM=18.0

# Routing: local haversine approximation (no external API needed)
ROUTING_PROVIDER=local-haversine

# Optional integrations (Phase 10) — not required for the MVP
# ROUTING_API_KEY=
# LLM_PROVIDER=
# LLM_API_KEY=
